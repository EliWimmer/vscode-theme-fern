{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Fern",
  "author": "Eli Wimmer",
  "themes": [
    {
      "name": "Fern",
      "appearance": "dark",
      "style": {
        "background": "bg1",
        "background.appearance": "opaque",
        "surface.background": "bg1",
        "elevated_surface.background": "float",
        "panel.background": "bg0",
        "panel.focused_border": "sel",
        "pane.focused_border": "sel",
        "pane_group.border": "bg4",
        "status_bar.background": "bg0",
        "title_bar.background": "bg1",
        "title_bar.inactive_background": "bg1",
        "toolbar.background": "bg0",
        "tab_bar.background": "bg0",
        "tab.active_background": "bg0-h",
        "tab.inactive_background": "bg0",

        "border": "bg4",
        "border.variant": "bg3",
        "border.focused": "aqua1",
        "border.selected": "blue1",
        "border.transparent": "bg0-h/00",
        "border.disabled": "bg2",

        "element.background": "bg2",
        "element.hover": "sel",
        "element.active": "bg3",
        "element.selected": "sel",
        "element.disabled": "bg1",
        "ghost_element.background": "bg0-h/00",
        "ghost_element.hover": "sel",
        "ghost_element.active": "bg3",
        "ghost_element.selected": "sel",
        "ghost_element.disabled": "bg1",
        "drop_target.background": "sel/80",

        "text": "fg",
        "text.muted": "fg3",
        "text.placeholder": "fg4",
        "text.disabled": "gray",
        "text.accent": "aqua2",
        "icon": "fg0",
        "icon.muted": "fg2",
        "icon.disabled": "gray",
        "icon.placeholder": "fg4",
        "icon.accent": "aqua2",
        "link_text.hover": "blue1",

        "scrollbar.thumb.background": "edge/99",
        "scrollbar.thumb.hover_background": "bg3",
        "scrollbar.thumb.border": "bg0-h/00",
        "scrollbar.track.background": "bg0-h/00",
        "scrollbar.track.border": "bg0-h/00",

        "editor.background": "bg0-h",
        "editor.foreground": "fg",
        "editor.gutter.background": "bg0",
        "editor.subheader.background": "bg1",
        "editor.line_number": "gutter",
        "editor.active_line_number": "fg1",
        "editor.hover_line_number": "fg2",
        "editor.active_line.background": "aqua1/10",
        "editor.highlighted_line.background": "sel",
        "editor.invisible": "faint/20",
        "editor.wrap_guide": "bg2",
        "editor.active_wrap_guide": "gutter",
        "editor.indent_guide": "bg3",
        "editor.indent_guide_active": "gutter",
        "editor.document_highlight.read_background": "aqua1/20",
        "editor.document_highlight.write_background": "green2/40",
        "editor.document_highlight.bracket_background": "gray/80",

        "panel.indent_guide": "bg4",
        "panel.indent_guide_active": "gutter",
        "panel.indent_guide_hover": "fg4",

        "search.match_background": "orange2/30",
        "search.active_match_background": "blue2/70",

        "error": "red1",
        "error.background": "red1/1a",
        "error.border": "red1",
        "warning": "yellow1",
        "warning.background": "yellow1/1a",
        "warning.border": "yellow1",
        "info": "blue1",
        "info.background": "blue1/1a",
        "info.border": "blue1",
        "hint": "purple2",
        "hint.background": "purple2/1a",
        "hint.border": "purple2",
        "success": "green1",
        "success.background": "green1/1a",
        "success.border": "green1",
        "created": "green1",
        "created.background": "green1/1a",
        "created.border": "green1",
        "modified": "yellow1",
        "modified.background": "yellow1/1a",
        "modified.border": "yellow1",
        "deleted": "red1",
        "deleted.background": "orange2/20",
        "deleted.border": "red1",
        "conflict": "purple2",
        "conflict.background": "purple2/1a",
        "conflict.border": "purple2",
        "ignored": "gray",
        "ignored.background": "gray/1a",
        "ignored.border": "gray",
        "hidden": "gray",
        "hidden.background": "gray/1a",
        "hidden.border": "gray",
        "renamed": "orange1",
        "renamed.background": "orange1/1a",
        "renamed.border": "orange1",
        "unreachable": "faint",
        "unreachable.background": "faint/1a",
        "unreachable.border": "faint",
        "predictive": "faint",
        "predictive.background": "faint/1a",
        "predictive.border": "faint",

        "version_control.added": "green1",
        "version_control.modified": "yellow1",
        "version_control.deleted": "red1",
        "version_control.word_added": "aqua2/10",
        "version_control.word_deleted": "orange2/20",
        "version_control.conflict_marker.ours": "blue1/20",
        "version_control.conflict_marker.theirs": "aqua1/20",

        "terminal.background": "bg0-h",
        "terminal.foreground": "fg",
        "terminal.bright_foreground": "fg0",
        "terminal.dim_foreground": "gray",
        "terminal.ansi.background": "bg0-h",
        "terminal.ansi.black": "sel",
        "terminal.ansi.bright_black": "gray",
        "terminal.ansi.dim_black": "bg4",
        "terminal.ansi.red": "red1",
        "terminal.ansi.bright_red": "orange2",
        "terminal.ansi.dim_red": "red1",
        "terminal.ansi.green": "green1",
        "terminal.ansi.bright_green": "green2",
        "terminal.ansi.dim_green": "green1",
        "terminal.ansi.yellow": "yellow1",
        "terminal.ansi.bright_yellow": "yellow2",
        "terminal.ansi.dim_yellow": "yellow1",
        "terminal.ansi.blue": "blue1",
        "terminal.ansi.bright_blue": "blue2",
        "terminal.ansi.dim_blue": "blue1",
        "terminal.ansi.magenta": "purple2",
        "terminal.ansi.bright_magenta": "purple2",
        "terminal.ansi.dim_magenta": "purple2",
        "terminal.ansi.cyan": "aqua1",
        "terminal.ansi.bright_cyan": "aqua2",
        "terminal.ansi.dim_cyan": "aqua1",
        "terminal.ansi.white": "faint",
        "terminal.ansi.bright_white": "fg",
        "terminal.ansi.dim_white": "gray",

        "accents": ["red1", "orange2", "yellow2", "green2", "aqua2", "blue2", "purple2", "blue1"],
        "players": [
          { "cursor": "aqua1", "background": "aqua1", "selection": "aqua1/3d" },
          { "cursor": "red1", "background": "red1", "selection": "red1/3d" },
          { "cursor": "orange2", "background": "orange2", "selection": "orange2/3d" },
          { "cursor": "yellow2", "background": "yellow2", "selection": "yellow2/3d" },
          { "cursor": "green2", "background": "green2", "selection": "green2/3d" },
          { "cursor": "blue2", "background": "blue2", "selection": "blue2/3d" },
          { "cursor": "purple2", "background": "purple2", "selection": "purple2/3d" },
          { "cursor": "blue1", "background": "blue1", "selection": "blue1/3d" }
        ],

        "syntax": {
          "attribute": { "color": "green2" },
          "boolean": { "color": "orange2" },
          "comment": { "color": "gray", "font_style": "italic" },
          "comment.doc": { "color": "faint", "font_style": "italic" },
          "constant": { "color": "purple2" },
          "constructor": { "color": "blue2" },
          "embedded": { "color": "fg" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "color": "orange2", "font_weight": 700 },
          "enum": { "color": "purple2" },
          "function": { "color": "aqua2" },
          "function.method": { "color": "green2" },
          "hint": { "color": "blue1" },
          "keyword": { "color": "orange2" },
          "label": { "color": "aqua1" },
          "link_text": { "color": "gray", "font_style": "italic" },
          "link_uri": { "color": "blue2" },
          "namespace": { "color": "blue2" },
          "number": { "color": "purple2" },
          "operator": { "color": "aqua2" },
          "predictive": { "color": "faint", "font_style": "italic" },
          "preproc": { "color": "red2" },
          "primary": { "color": "fg" },
          "property": { "color": "blue2" },
          "punctuation": { "color": "faint" },
          "punctuation.bracket": { "color": "fg2" },
          "punctuation.delimiter": { "color": "faint" },
          "punctuation.list_marker": { "color": "orange2" },
          "punctuation.markup": { "color": "orange2" },
          "punctuation.special": { "color": "orange2" },
          "selector": { "color": "aqua2" },
          "selector.pseudo": { "color": "blue2" },
          "string": { "color": "aqua2" },
          "string.escape": { "color": "red1" },
          "string.regex": { "color": "red2" },
          "string.special": { "color": "green2" },
          "string.special.symbol": { "color": "purple2" },
          "tag": { "color": "aqua2" },
          "text.literal": { "color": "aqua2" },
          "title": { "color": "orange2", "font_weight": 700 },
          "type": { "color": "green2" },
          "variable": { "color": "fg" },
          "variable.parameter": { "color": "blue2" },
          "variable.special": { "color": "purple2" },
          "variant": { "color": "purple2" },
          "diff.plus": { "color": "green1" },
          "diff.minus": { "color": "red1" }
        }
      }
    }
  ]
}
