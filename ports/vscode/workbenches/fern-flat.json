{
  "$schema": "vscode://schemas/color-theme",
  "name": "Fern Flat",
  "type": "dark",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "blue1"
      }
    },
    {
      "scope": [ "comment", "punctuation.definition.comment" ],
      "settings": {
        "foreground": "gray",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [ "constant", "support.constant", "variable.arguments" ],
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": "constant.rgb-value",
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": "entity.name.selector",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": [ "entity.name.tag", "punctuation.tag" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": [ "invalid", "invalid.illegal" ],
      "settings": {
        "foreground": "red1"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": "meta.selector",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "meta.preprocessor",
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": "meta.preprocessor.string",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "meta.preprocessor.numeric",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "meta.header.diff",
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": [ "storage.type", "storage.modifier" ],
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "string.tag",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "string.value",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": "string.escape",
      "settings": {
        "foreground": "red1"
      }
    },
    {
      "scope": "string.quasi",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "string.entity",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "object",
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": "module.node",
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "aqua1"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": "keyword.control",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "keyword.control.module",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "keyword.control.less",
      "settings": {
        "foreground": "yellow1"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "keyword.operator.new",
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "metatag.php",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "support.function.git-rebase",
      "settings": {
        "foreground": "aqua1"
      }
    },
    {
      "scope": "constant.sha.git-rebase",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "name": "Types declaration and references",
      "scope": [
        "meta.type.name",
        "meta.return.type",
        "meta.return-type",
        "meta.cast",
        "meta.type.annotation",
        "support.type",
        "storage.type.cs",
        "variable.class"
      ],
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": [ "variable.this", "support.variable" ],
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": [
        "entity.name",
        "entity.static",
        "entity.name.class.static.function",
        "entity.name.function",
        "entity.name.class",
      ],
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "name": "Function declarations",
      "scope": [ "entity.function", "entity.name.function.static", "entity.name.function" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": [ "entity.name.function.function-call", "meta.function-call.ts" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "support.function.builtin",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": [
        "entity.name.method",
        "entity.name.method.function-call",
        "entity.name.static.function-call"
      ],
      "settings": {
        "foreground": "aqua1"
      }
    },
    {
      "scope": "brace",
      "settings": {
        "foreground": "fg2"
      }
    },
    {
      "name": "variables",
      "scope": [
        "meta.parameter.type.variable",
        "variable.parameter",
        "variable.name",
        "variable.other",
        "variable",
        "string.constant.other.placeholder"
      ],
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "scope": "prototype",
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": [ "punctuation" ],
      "settings": {
        "foreground": "faint"
      }
    },
    {
      "scope": "punctuation.quoted",
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": "punctuation.quasi",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "name": "URL",
      "scope": [ "*url*", "*link*", "*uri*" ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    // ----------------------------------------
    //            LANGUAGE SPECIFIC
    // ----------------------------------------
    // PYTHON ----------------------------------------
    {
      "name": "Python function",
      "scope": [ "meta.function.python", "entity.name.function.python" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "name": "Python Function and Class definition keywords",
      "scope": [
        "storage.type.function.python",
        "storage.modifier.declaration",
        "storage.type.class.python",
        "storage.type.string.python"
      ],
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "name": "Async keyword",
      "scope": [ "storage.type.function.async.python" ],
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "name": "Python Function Call",
      "scope": "meta.function-call.generic",
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "name": "Python Function Arguments",
      "scope": "meta.function-call.arguments",
      "settings": {
        "foreground": "fg2"
      }
    },
    {
      "name": "Python Function decorator",
      "scope": "entity.name.function.decorator",
      "settings": {
        "foreground": "green2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python ALL CAPS",
      "scope": "constant.other.caps",
      "settings": {
        "fontStyle": "bold"
      }
    },
    // SHELL ----------------------------------------
    {
      "scope": "keyword.operator.logical",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "punctuation.definition.logical-expression",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": [
        "string.interpolated.dollar.shell",
        "string.interpolated.backtick.shell"
      ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    // C C++ ----------------------------------------
    {
      "scope": "keyword.control.directive",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "support.function.C99",
      "settings": {
        "foreground": "green2"
      }
    },
    // C# ----------------------------------------
    {
      "name": "C# functions & namespace",
      "scope": [
        "meta.function.cs",
        "entity.name.function.cs",
        "entity.name.type.namespace.cs"
      ],
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "name": "C# Variables",
      "scope": [
        "keyword.other.using.cs",
        "entity.name.variable.field.cs",
        "entity.name.variable.local.cs",
        "variable.other.readwrite.cs"
      ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "name": "C# This",
      "scope": [ "keyword.other.this.cs", "keyword.other.base.cs" ],
      "settings": {
        "foreground": "purple2"
      }
    },
    // MAKEFILE ----------------------------------------
    {
      "scope": "meta.scope.prerequisites",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "entity.name.function.target",
      "settings": {
        "foreground": "green2",
        "fontStyle": "bold"
      }
    },
    // JAVA ----------------------------------------
    {
      "name": "coloring of the Java import and package identifiers",
      "scope": [
        "storage.modifier.import.java",
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "mist"
      }
    },
    {
      "scope": [ "keyword.other.import.java", "keyword.other.package.java" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "storage.type.java",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "storage.type.annotation",
      "settings": {
        "foreground": "blue2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.other.documentation.javadoc",
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": "comment.block.javadoc variable.parameter.java",
      "settings": {
        "foreground": "green2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "source.java variable.other.object",
        "source.java variable.other.definition.java"
      ],
      "settings": {
        "foreground": "fg"
      }
    },
    // LISP ----------------------------------------
    {
      "name": "Lisp optional function parameters",
      "scope": "meta.function-parameters.lisp",
      "settings": {
        "foreground": "green2"
      }
    },
    // MARKUP ----------------------------------------
    {
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": "string.other.link.title.markdown",
      "settings": {
        "foreground": "gray",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "orange2"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "fontStyle": "bold",
        "foreground": "orange2"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "orange1"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "markup.punctuation.quote.beginning",
      "settings": {
        "foreground": "green1"
      }
    },
    {
      "scope": "markup.punctuation.list.beginning",
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "scope": [ "markup.inline.raw", "markup.fenced_code.block" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    // JSON ----------------------------------------
    {
      "scope": "string.quoted.double.json",
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "name": "JSON Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "name": "JSON Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "name": "JSON Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "name": "JSON Level 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "green2"
      }
    },
    // CSS ----------------------------------------
    {
      "scope": "entity.other.attribute-name.css",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "source.css meta.selector",
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": "support.type.property-name.css",
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": "entity.other.attribute-name.class",
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "scope": [
        "source.css support.function.transform",
        "source.css support.function.timing-function",
        "source.css support.function.misc"
      ],
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "support.constant.property-value.css",
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "name": "CSS property value",
      "scope": [
        "support.property-value",
        "constant.rgb-value",
        "support.property-value.scss",
        "constant.rgb-value.scss"
      ],
      "settings": {
        "foreground": "orange1"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "yellow2"
      }
    },
    {
      "scope": [ "constant.numeric.css" ],
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": ["variable.css", "variable.scss"],
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": [ "entity.name.tag.css" ],
      "settings": {
        "fontStyle": ""
      }
    },
    // HTML / XML ----------------------------------------
    {
      "scope": [ "punctuation.definition.tag" ],
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "scope": [ "text.html entity.name.tag", "text.html punctuation.tag" ],
      "settings": {
        "foreground": "green2",
      }
    },
    {
      "scope": "entity.other.attribute-name.html",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": [ "punctuation.definition.string.end.html", "punctuation.definition.string.begin.html" ],
      "settings": {
        "foreground": "aqua1"
      }
    },
    // javascript ---------------------------------------
    {
      "scope": [ "source.js variable.language" ],
      "settings": {
        "foreground": "orange2"
      }
    },
    // typescript ---------------------------------------
    {
      "scope": [ "source.ts variable.language" ],
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "meta.function-call.ts",
      "settings": {
        "foreground": "purple2"
      }
    },
    {
      "scope": "variable.other.object.ts",
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": "entity.name.function.ts",
      "settings": {
        "foreground": "green2"
      }
    },
    // JSDoc --------------------------------------------
    {
      "scope": "storage.type.class.jsdoc",
      "settings": {
        "foreground": "red1"
      }
    },
    {
      "scope": "variable.other.jsdoc",
      "settings": {
        "foreground": "aqua1"
      }
    },
    // golang --------------------------------------------
    {
      "scope": [ "source.go storage.type" ],
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": [ "source.go entity.name.import" ],
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "scope": [ "source.go keyword.package", "source.go keyword.import" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "scope": [ "source.go keyword.interface", "source.go keyword.struct" ],
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "scope": [ "source.go entity.name.type" ],
      "settings": {
        "foreground": "fg"
      }
    },
    {
      "scope": [ "source.go entity.name.function" ],
      "settings": {
        "foreground": "purple2"
      }
    },
    // cucumber
    {
      "scope": [ "keyword.control.cucumber.table" ],
      "settings": {
        "foreground": "blue2"
      }
    },
    // REASONML ------------------------------------
    {
      "name": "ReasonML String",
      "scope": [ "source.reason string.double", "source.reason string.regexp" ],
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "name": "ReasonML equals sign",
      "scope": [ "source.reason keyword.control.less" ],
      "settings": {
        "foreground": "aqua2"
      }
    },
    {
      "name": "ReasonML variable",
      "scope": [ "source.reason entity.name.function" ],
      "settings": {
        "foreground": "blue2"
      }
    },
    {
      "name": "ReasonML property",
      "scope": [
        "source.reason support.property-value",
        "source.reason entity.name.filename"
      ],
      "settings": {
        "foreground": "orange2"
      }
    },
    // POWERSHELL ------------------------------------
    {
      "name": "Powershell member",
      "scope": [ "source.powershell variable.other.member.powershell" ],
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "name": "Powershell function",
      "scope": [ "source.powershell support.function.powershell" ],
      "settings": {
        "foreground": "green2"
      }
    },
    {
      "name": "Powershell function attribute",
      "scope": [ "source.powershell support.function.attribute.powershell" ],
      "settings": {
        "foreground": "mist"
      }
    },
    {
      "name": "Powershell hashtable member",
      "scope": [
        "source.powershell meta.hashtable.assignment.powershell variable.other.readwrite.powershell"
      ],
      "settings": {
        "foreground": "orange2"
      }
    },
    // SVELTE ----------------------------------------
    {
      "scope": "entity.name.tag.svelte",
      "settings": {
        "foreground": "green2"
      }
    },

    {
      "scope": "entity.other.attribute-name.svelte",
      "settings": {
        "foreground": "orange2"
      }
    },
    {
      "scope": "support.class.component.svelte",
      "settings": {
        "foreground": "red2"
      }
    },
    {
      "scope": "keyword.control.conditional.svelte",
      "settings": {
        "foreground": "red2"
      }
    }
  ],
  "colors": {
    // BASE COLORS
    "focusBorder": "sel",
    "foreground": "fg",
    "widget.shadow": "bg0-h/00",
    "selection.background": "aqua1/80",
    "errorForeground": "orange2",
    "icon.foreground": "fg0",

    // BUTTON
    "button.background": "aqua1",
    "button.foreground": "fg",
    "button.hoverBackground": "aqua1/95",

    // DROPDOWN
    "dropdown.background": "bg0-h",
    "dropdown.border": "sel",
    "dropdown.foreground": "fg",

    // INPUT
    "input.background": "fg/05",
    "input.border": "sel",
    "input.foreground": "fg",
    "input.placeholderForeground": "fg/60",
    "inputValidation.errorBorder": "orange2",
    "inputValidation.errorBackground": "red1",
    "inputValidation.infoBorder": "blue2",
    "inputValidation.infoBackground": "blue1/80",
    "inputValidation.warningBorder": "green2",
    "inputValidation.warningBackground": "yellow1/80",
    "inputOption.activeBorder": "fg/60",

    // SCROLL BAR
    "scrollbar.shadow": "float",
    "scrollbarSlider.activeBackground": "aqua1",
    "scrollbarSlider.hoverBackground": "bg3",
    "scrollbarSlider.background": "edge/99",

    // BADGE
    "badge.background": "purple2",
    "badge.foreground": "float",

    // PROGRESS BAR
    "progressBar.background": "aqua1",

    // LISTS AND TREES
