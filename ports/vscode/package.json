{
  "name": "fern",
  "displayName": "Fern Theme",
  "description": "Fern Theme",
  "version": "0.0.6",
  "author": "EliWimmer (https://github.com/EliWimmer)",
  "contributors": [ ],
  "publisher": "EliWimmer",
  "engines": {
    "vscode": "^1.67.2"
  },
  "categories": [
    "Themes"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#363C38",
    "theme": "dark"
  },
  "homepage": "https://github.com/EliWimmer/vscode-theme-fern",
  "repository": {
    "url": "https://github.com/EliWimmer/vscode-theme-fern"
  },
  "contributes": {
    "themes": [
      {
        "label": "Fern",
        "uiTheme": "vs-dark",
        "path": "./themes/fern.json"
      },
      {
        "label": "Fern Flat",
        "uiTheme": "vs-dark",
        "path": "./themes/fern-flat.json"
      }
    ],
    "iconThemes": [
      {
        "id": "fern-icons",
        "label": "Fern Icons",
        "path": "./themes/file-icons.json"
      }
    ]
  },
  "devDependencies": {
    "ovsx": "^0.8.3",
    "tsx": "^4.19.2",
    "vsce": "^2.9.0"
  },
  "private": true,
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "vscode:prepublish": "npm run build",
    "build:icons": "npx tsx scripts/build-icons.ts"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EliWimmer/vscode-theme-fern/issues"
  },
  "type": "module"
}
